#ifndef EASYNAV_CORE__EXPECTED_HPP_
#define EASYNAV_CORE__EXPECTED_HPP_

#include <type_traits>
#include <utility>
#include <exception>
#include <initializer_list>
#include <stdexcept>
#include <new>

/*
 * expected.hpp — GCC 11 shim for std::expected (with void specialization)
 * ----------------------------------------------------------------------
 * This header provides a minimal, header-only stand-in for std::expected<T, E>
 * on toolchains that do not ship <expected> yet (e.g., GCC 11 on Ubuntu 22.04).
 *
 * It includes:
 *   - easynav::unexpect_t and easynav::unexpect tag
 *   - easynav::bad_expected_access<E>
 *   - easynav::unexpected<E> and easynav::make_unexpected(...)
 *   - easynav::expected<T, E>  (primary template for non-void T)
 *   - easynav::expected<void, E> specialization
 *
 * A minimal and safe exposure is provided in namespace std:
 *   - using std::expected = easynav::expected
 *   - using std::unexpect_t = easynav::unexpect_t;
 *   - inline constexpr std::unexpect = easynav::unexpect;
 *   - std::make_unexpected(...) returning easynav::unexpected<E>
 *
 * IMPORTANT:
 *   - std::unexpected<E> is NOT declared here to avoid clashing with the legacy
 *     function std::unexpected() that exists in libstdc++ for GCC 11.
 *
 * Usage:
 *   Replace `#include <expected>` with `#include "easynav_core/expected.hpp"`
 *   and keep using std::expected<T, E> in your code.
 */

namespace easynav
{

// -----------------------------------------------------------------------------
// unexpect_t / unexpect (tag used to construct the error alternative)
// -----------------------------------------------------------------------------
struct unexpect_t { explicit constexpr unexpect_t(int) {} };
inline constexpr unexpect_t unexpect{0};

// -----------------------------------------------------------------------------
// bad_expected_access<E>
// -----------------------------------------------------------------------------
template<class E>
class bad_expected_access : public std::exception {
public:
  explicit bad_expected_access(const E & e)
  : err_(e) {}
  explicit bad_expected_access(E && e)
  : err_(std::move(e)) {}

  const char * what() const noexcept override {return "bad expected access";}
  const E & error() const noexcept {return err_;}

private:
  E err_;
};

// -----------------------------------------------------------------------------
// unexpected<E> (helper equivalent to std::unexpected<E> in C++23)
// -----------------------------------------------------------------------------
template<class E>
class unexpected {
public:
  using error_type = E;

  unexpected() = delete;

  constexpr explicit unexpected(const E & e)
  : e_(e) {}
  constexpr explicit unexpected(E && e)
  : e_(std::move(e)) {}

  template<class ... Args, std::enable_if_t<std::is_constructible<E, Args...>::value, int> = 0>
  constexpr explicit unexpected(std::in_place_t, Args &&... args)
  : e_(std::forward<Args>(args)...) {}

  template<class U, class ... Args,
    std::enable_if_t<std::is_constructible<E, std::initializer_list<U>, Args...>::value, int> = 0>
  constexpr explicit unexpected(std::in_place_t, std::initializer_list<U> il, Args &&... args)
  : e_(il, std::forward<Args>(args)...) {}

  constexpr const E & error() const & noexcept {return e_;}
  constexpr E & error() & noexcept {return e_;}
  constexpr const E && error() const && noexcept {return std::move(e_);}
  constexpr E && error() && noexcept {return std::move(e_);}

  friend constexpr bool operator==(const unexpected & a, const unexpected & b)
  {
    return a.e_ == b.e_;
  }
  friend constexpr bool operator!=(const unexpected & a, const unexpected & b) {return !(a == b);}

private:
  E e_;
};

template<class E>
constexpr unexpected<std::decay_t<E>> make_unexpected(E && e)
{
  return unexpected<std::decay_t<E>>(std::forward<E>(e));
}

// -----------------------------------------------------------------------------
// expected<T, E> — primary template (T != void, E != void)
// -----------------------------------------------------------------------------
template<class T, class E>
class expected {
  static_assert(!std::is_void<T>::value, "non-void T required in the primary template");
  static_assert(!std::is_void<E>::value, "non-void E required");

public:
  using value_type = T;
  using error_type = E;

  // Manual discriminated union (avoids std::variant<void, ...> issues)
  union storage_t {
    T val;
    E err;
    storage_t() {}
    ~storage_t() {}
  } st_;
  bool has_ = false;

  // ------------------------------- constructors ------------------------------
  expected() = delete;

  // Construct as value
  template<class U = T, std::enable_if_t<std::is_constructible<T, U &&>::value, int> = 0>
  constexpr explicit expected(U && v)
  : has_(true)
  {
    ::new (static_cast<void *>(std::addressof(st_.val))) T(std::forward<U>(v));
  }

  template<class ... Args, std::enable_if_t<std::is_constructible<T, Args...>::value, int> = 0>
  constexpr explicit expected(std::in_place_t, Args &&... args)
  : has_(true)
  {
    ::new (static_cast<void *>(std::addressof(st_.val))) T(std::forward<Args>(args)...);
  }

  template<class U, class ... Args,
    std::enable_if_t<std::is_constructible<T, std::initializer_list<U>, Args...>::value, int> = 0>
  constexpr explicit expected(std::in_place_t, std::initializer_list<U> il, Args &&... args)
  : has_(true)
  {
    ::new (static_cast<void *>(std::addressof(st_.val))) T(il, std::forward<Args>(args)...);
  }

  // Construct as error (via tag)
  template<class ... Args, std::enable_if_t<std::is_constructible<E, Args...>::value, int> = 0>
  constexpr expected(easynav::unexpect_t, Args &&... args)
  : has_(false)
  {
    ::new (static_cast<void *>(std::addressof(st_.err))) E(std::forward<Args>(args)...);
  }

  template<class U, class ... Args,
    std::enable_if_t<std::is_constructible<E, std::initializer_list<U>, Args...>::value, int> = 0>
  constexpr expected(easynav::unexpect_t, std::initializer_list<U> il, Args &&... args)
  : has_(false)
  {
    ::new (static_cast<void *>(std::addressof(st_.err))) E(il, std::forward<Args>(args)...);
  }

  // Construct from unexpected<E>
  constexpr expected(const easynav::unexpected<E> & u)
  : has_(false)
  {
    ::new (static_cast<void *>(std::addressof(st_.err))) E(u.error());
  }
  constexpr expected(easynav::unexpected<E> && u)
  : has_(false)
  {
    ::new (static_cast<void *>(std::addressof(st_.err))) E(std::move(u.error()));
  }

  // Copy / move
  expected(const expected & other)
  : has_(other.has_)
  {
    if (has_) {::new (&st_.val) T(other.st_.val);} else {::new (&st_.err) E(other.st_.err);}
  }
  expected(expected && other) noexcept(std::is_nothrow_move_constructible<T>::value &&
  std::is_nothrow_move_constructible<E>::value)
  : has_(other.has_)
  {
    if (has_) {::new (&st_.val) T(std::move(other.st_.val));} else {
      ::new (&st_.err) E(std::move(other.st_.err));
    }
  }

  expected & operator=(const expected & other)
  {
    if (this == &other) {return *this;}
    if (has_ && other.has_) {
      st_.val = other.st_.val;
    } else if (!has_ && !other.has_) {
      st_.err = other.st_.err;
    } else {
      this->~expected();
      has_ = other.has_;
      if (has_) {::new (&st_.val) T(other.st_.val);} else {::new (&st_.err) E(other.st_.err);}
    }
    return *this;
  }

  expected & operator=(expected && other) noexcept(std::is_nothrow_move_assignable<T>::value &&
  std::is_nothrow_move_assignable<E>::value)
  {
    if (this == &other) {return *this;}
    if (has_ && other.has_) {
      st_.val = std::move(other.st_.val);
    } else if (!has_ && !other.has_) {
      st_.err = std::move(other.st_.err);
    } else {
      this->~expected();
      has_ = other.has_;
      if (has_) {::new (&st_.val) T(std::move(other.st_.val));} else {
        ::new (&st_.err) E(std::move(other.st_.err));
      }
    }
    return *this;
  }

  ~expected()
  {
    if (has_) {st_.val.~T();} else {st_.err.~E();}
  }

  // --------------------------------- observers -------------------------------
  constexpr bool has_value() const noexcept {return has_;}
  constexpr explicit operator bool() const noexcept {return has_value();}

  const T & value() const &
  {
    if (!has_) {throw easynav::bad_expected_access<E>(st_.err);}
    return st_.val;
  }
  T & value() &
  {
    if (!has_) {throw easynav::bad_expected_access<E>(st_.err);}
    return st_.val;
  }
  T && value() &&
  {
    if (!has_) {throw easynav::bad_expected_access<E>(st_.err);}
    return std::move(st_.val);
  }
  const T && value() const &&
  {
    if (!has_) {throw easynav::bad_expected_access<E>(st_.err);}
    return std::move(st_.val);
  }

  const E & error() const &
  {
    if (has_) {throw std::logic_error("bad expected access: holds value");}
    return st_.err;
  }
  E & error() &
  {
    if (has_) {throw std::logic_error("bad expected access: holds value");}
    return st_.err;
  }
  E && error() &&
  {
    if (has_) {throw std::logic_error("bad expected access: holds value");}
    return std::move(st_.err);
  }
  const E && error() const &&
  {
    if (has_) {throw std::logic_error("bad expected access: holds value");}
    return std::move(st_.err);
  }

  // --------------------------------- modifiers -------------------------------
  template<class... Args>
  T & emplace(Args &&... args)
  {
    if (has_) {st_.val.~T();} else {st_.err.~E();}
    ::new (&st_.val) T(std::forward<Args>(args)...);
    has_ = true;
    return st_.val;
  }

  void swap(expected & other)
  {
    if (has_ && other.has_) {
      using std::swap;
      swap(st_.val, other.st_.val);
    } else if (!has_ && !other.has_) {
      using std::swap;
      swap(st_.err, other.st_.err);
    } else {
      expected tmp(std::move(other));
      other = std::move(*this);
      *this = std::move(tmp);
    }
  }

  // -------------------------------- monadic ops ------------------------------
  template<class F>
  auto transform(F && f) const & ->expected<std::decay_t<decltype(f(std::declval<const T &>()))>, E>
  {
    using U = std::decay_t<decltype(f(std::declval<const T &>()))>;
    if (has_) {return expected<U, E>(std::in_place, f(st_.val));}
    return expected<U, E>(easynav::unexpect, st_.err);
  }

  template<class F>
  auto and_then(F && f) &
  {
    if (has_) {return std::forward<F>(f)(st_.val);} // must return expected<U,E>
    using Ret = decltype(std::forward<F>(f)(st_.val));
    return Ret(easynav::unexpect, st_.err);
  }
  template<class F>
  auto and_then(F && f) const &
  {
    if (has_) {return std::forward<F>(f)(st_.val);}
    using Ret = decltype(std::forward<F>(f)(st_.val));
    return Ret(easynav::unexpect, st_.err);
  }

  template<class F>
  auto or_else(F && g) &
  {
    if (has_) {return *this;}
    return std::forward<F>(g)(st_.err); // must return expected<T,E>
  }
  template<class F>
  auto or_else(F && g) const &
  {
    if (has_) {return *this;}
    return std::forward<F>(g)(st_.err);
  }

  template<class U>
  T value_or(U && alt) const &
  {
    return has_ ? st_.val : static_cast<T>(std::forward<U>(alt));
  }

  // -------------------------------- comparisons ------------------------------
  friend bool operator==(const expected & a, const expected & b)
  {
    if (a.has_ != b.has_) {return false;}
    return a.has_ ? (a.st_.val == b.st_.val) : (a.st_.err == b.st_.err);
  }
  friend bool operator!=(const expected & a, const expected & b) {return !(a == b);}
};

// ADL swap for expected<T, E>
template<class T, class E>
void swap(expected<T, E> & a, expected<T, E> & b) {a.swap(b);}

// -----------------------------------------------------------------------------
// expected<void, E> — specialization
// -----------------------------------------------------------------------------
template<class E>
class expected<void, E> {
  static_assert(!std::is_void<E>::value, "non-void E required");

public:
  using value_type = void;
  using error_type = E;

  union storage_t {
    char dummy; // occupies the "value" alternative
    E err;
    storage_t() {}
    ~storage_t() {}
  } st_;
  bool has_ = true; // default-constructed as "has value"

  // ------------------------------- constructors ------------------------------
  constexpr expected() noexcept
  : has_(true) {::new (&st_.dummy) char(0);}
  constexpr explicit expected(std::in_place_t) noexcept
  : has_(true) {::new (&st_.dummy) char(0);}

  // Construct as error (via tag)
  template<class ... Args, std::enable_if_t<std::is_constructible<E, Args...>::value, int> = 0>
  constexpr expected(easynav::unexpect_t, Args &&... args)
  : has_(false)
  {
    ::new (static_cast<void *>(std::addressof(st_.err))) E(std::forward<Args>(args)...);
  }
  template<class U, class ... Args,
    std::enable_if_t<std::is_constructible<E, std::initializer_list<U>, Args...>::value, int> = 0>
  constexpr expected(easynav::unexpect_t, std::initializer_list<U> il, Args &&... args)
  : has_(false)
  {
    ::new (static_cast<void *>(std::addressof(st_.err))) E(il, std::forward<Args>(args)...);
  }

  // Construct from unexpected<E>
  constexpr expected(const easynav::unexpected<E> & u)
  : has_(false)
  {
    ::new (static_cast<void *>(std::addressof(st_.err))) E(u.error());
  }
  constexpr expected(easynav::unexpected<E> && u)
  : has_(false)
  {
    ::new (static_cast<void *>(std::addressof(st_.err))) E(std::move(u.error()));
  }

  // Copy / move
  expected(const expected & other)
  : has_(other.has_)
  {
    if (has_) {::new (&st_.dummy) char(0);} else {::new (&st_.err) E(other.st_.err);}
  }
  expected(expected && other) noexcept(std::is_nothrow_move_constructible<E>::value)
  : has_(other.has_)
  {
    if (has_) {::new (&st_.dummy) char(0);} else {::new (&st_.err) E(std::move(other.st_.err));}
  }

  expected & operator=(const expected & other)
  {
    if (this == &other) {return *this;}
    if (has_ && other.has_) {
      // nothing to do
    } else if (!has_ && !other.has_) {
      st_.err = other.st_.err;
    } else {
      this->~expected();
      has_ = other.has_;
      if (has_) {::new (&st_.dummy) char(0);} else {::new (&st_.err) E(other.st_.err);}
    }
    return *this;
  }

  expected & operator=(expected && other) noexcept(std::is_nothrow_move_assignable<E>::value)
  {
    if (this == &other) {return *this;}
    if (has_ && other.has_) {
      // nothing to do
    } else if (!has_ && !other.has_) {
      st_.err = std::move(other.st_.err);
    } else {
      this->~expected();
      has_ = other.has_;
      if (has_) {::new (&st_.dummy) char(0);} else {::new (&st_.err) E(std::move(other.st_.err));}
    }
    return *this;
  }

  ~expected()
  {
    if (!has_) {st_.err.~E();}
  }

  // --------------------------------- observers -------------------------------
  constexpr bool has_value() const noexcept {return has_;}
  constexpr explicit operator bool() const noexcept {return has_value();}

  // value(): asserts presence, throws if error
  void value() const
  {
    if (!has_) {throw easynav::bad_expected_access<E>(st_.err);}
  }

  const E & error() const &
  {
    if (has_) {throw std::logic_error("bad expected access: holds value");}
    return st_.err;
  }
  E & error() &
  {
    if (has_) {throw std::logic_error("bad expected access: holds value");}
    return st_.err;
  }
  E && error() &&
  {
    if (has_) {throw std::logic_error("bad expected access: holds value");}
    return std::move(st_.err);
  }
  const E && error() const &&
  {
    if (has_) {throw std::logic_error("bad expected access: holds value");}
    return std::move(st_.err);
  }

  // --------------------------------- modifiers -------------------------------
  void emplace() noexcept
  {
    if (!has_) {
      st_.err.~E();
      ::new (&st_.dummy) char(0);
      has_ = true;
    }
  }

  void swap(expected & other)
  {
    if (has_ && other.has_) {
      // nothing to do
    } else if (!has_ && !other.has_) {
      using std::swap;
      swap(st_.err, other.st_.err);
    } else {
      expected tmp(std::move(other));
      other = std::move(*this);
      *this = std::move(tmp);
    }
  }

  // -------------------------------- monadic ops ------------------------------
  // transform: f() -> U (no argument because T = void)
  template<class F>
  auto transform(F && f) const & ->expected<std::decay_t<decltype(f())>, E>
  {
    using U = std::decay_t<decltype(f())>;
    if (has_) {return expected<U, E>(std::in_place, std::forward<F>(f)());}
    return expected<U, E>(easynav::unexpect, st_.err);
  }

  // and_then: f() -> expected<U, E>
  template<class F>
  auto and_then(F && f) &
  {
    if (has_) {return std::forward<F>(f)();}
    using Ret = decltype(std::forward<F>(f)());
    return Ret(easynav::unexpect, st_.err);
  }
  template<class F>
  auto and_then(F && f) const &
  {
    if (has_) {return std::forward<F>(f)();}
    using Ret = decltype(std::forward<F>(f)());
    return Ret(easynav::unexpect, st_.err);
  }

  // or_else: g(E) -> expected<void, E>
  template<class F>
  auto or_else(F && g) &
  {
    if (has_) {return *this;}
    return std::forward<F>(g)(st_.err);
  }
  template<class F>
  auto or_else(F && g) const &
  {
    if (has_) {return *this;}
    return std::forward<F>(g)(st_.err);
  }

  // -------------------------------- comparisons ------------------------------
  friend bool operator==(const expected & a, const expected & b)
  {
    if (a.has_ != b.has_) {return false;}
    return a.has_ ? true : (a.st_.err == b.st_.err);
  }
  friend bool operator!=(const expected & a, const expected & b) {return !(a == b);}
};

// ADL swap for expected<void, E>
template<class E>
void swap(expected<void, E> & a, expected<void, E> & b) {a.swap(b);}

} // namespace easynav

// -----------------------------------------------------------------------------
// Minimal and safe exposure in namespace std
// -----------------------------------------------------------------------------
namespace std
{

// Alias std::expected<T, E> to the shim
template<class T, class E>
using expected = ::easynav::expected<T, E>;

// Expose unexpect tag into std::
using unexpect_t = ::easynav::unexpect_t;
inline constexpr unexpect_t unexpect = ::easynav::unexpect;

// Provide std::make_unexpected(...) returning easynav::unexpected<E>
template<class E>
constexpr auto make_unexpected(E && e)
-> ::easynav::unexpected<std::decay_t<E>>
{
  return ::easynav::unexpected<std::decay_t<E>>(std::forward<E>(e));
}

// Note: std::unexpected<E> is intentionally NOT declared here.
// GCC 11 ships a legacy std::unexpected() function in <exception>.

} // namespace std


#endif  // EASYNAV_CORE__LOCALIZERMETHODBASE_HPP_
